{
  "name": "collector-shop",
  "version": "0.1.0",
  "private": true,
  "description": "Collector.shop : POC de place de marché d'objets de collection entre particuliers (NestJS, React, AWS EKS)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^19.8.0",
    "husky": "^9.1.7"
  }
}
