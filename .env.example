# Copier en .env pour le développement local (docker compose). Ne jamais committer .env.
POSTGRES_USER=collector
POSTGRES_PASSWORD=change-me
POSTGRES_DB=collector
RABBITMQ_DEFAULT_USER=collector
RABBITMQ_DEFAULT_PASS=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Stockage objet des photos (RustFS en local, Amazon S3 dans le POC)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=collector
S3_SECRET_KEY=change-me-please
S3_BUCKET_PHOTOS=collector-photos
