    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
