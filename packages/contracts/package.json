{
  "name": "@collector/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Contrats d'événements partagés entre les services (types TypeScript)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
