{
  "name": "@collector/nest-common",
  "version": "0.1.0",
  "private": true,
  "description": "Briques NestJS partagées par les services : configuration HTTP commune, métriques Prometheus (/metrics)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/testing": "^12.5.1",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "rxjs": "^7.8.2",
    "reflect-metadata": "^0.2.2"
  }
}
